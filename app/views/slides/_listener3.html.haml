%h1 Third Problem: Add a Listener

= render 'answer_buttons_html'

%pre{:class => 'brush: js'}
  :preserve
  :escaped
    $(function() {
      $('a.answer-link').click(function(event) {
        event.preventDefault();
        $('a.answer-link', $(this).parent()).removeClass('selected');
        $(this).addClass('selected');
        return false;
      });
    });

