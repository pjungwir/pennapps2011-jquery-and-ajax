#slide
  = render "#{@slide.name}"
  .clear
.clear

.slide-navigation
  - unless @slide.first_slide?
    = link_to @slide.prev_slide, :class => 'prev-slide-link' do
      .prev-slide
        Prev:
        = @slide.prev_slide.name


  - unless @slide.last_slide?
    = link_to @slide.next_slide, :class => 'next-slide-link' do
      .next-slide
        Next:
        = @slide.next_slide.name

  .clear

