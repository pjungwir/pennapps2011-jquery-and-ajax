%h1 Third Problem: Add a Listener

- m_percent = 80

.electnext-header
  = image_tag 'logo-flat-85.png'
.candidate-header Rick Perry

.candidate-column
  .candidate-info-column-inner
    .block
      = image_tag 'rick_perry.jpeg', :class => 'candidate-photo'

    .block.padded.alignment
      %h3 Alignment
      .overall
        = "<span id='overall-match-score-dead'>#{m_percent}</span><span class='percent-sign'>%</span>".html_safe
      .other-questions
        5 other questions<br/>answered

    .block.padded
      %h3 Seeking<br/>the office of:
      .office-sought.round President<br/>of the<br/>United States
      .election-day
        Election on:
        %br
        September 6, 2012


.candidate-main
  .question-text
    Capital punishment should be abolished.

  .answer-buttons
    - [['strongly-disagree', 'Strongly<br/>Disagree', 'sd'],
       ['disagree', 'Disagree', 'd'],
       ['neutral', 'Neutral', 'n'],
       ['agree', 'Agree', 'a'],
       ['strongly-agree', 'Strongly<br/>Agree', 'sa']].each do |tuple|

      = link_to "/questions/56/answer?score=#{tuple[2]}", :class => 'answer-link', :method => :post do
        .answer-button{:class => tuple[0]}= tuple[1].html_safe
  .clear


