%table
  %tr
    %th Order
    %th &nbsp;
    %th &nbsp;
    %th Name
    %th &nbsp;
    %th &nbsp;
  - Slide.in_order.all.each do |slide|
    %tr
      %td= slide.sort_order
      %td= link_to '[up]', decrement_admin_slide_path(slide), :method => :post
      %td= link_to '[down]', increment_admin_slide_path(slide), :method => :post
      %td= link_to slide.name, slide
      %td= link_to '[edit]', edit_admin_slide_path(slide)
      %td= link_to '[destroy]', admin_slide_path(slide), :method => :delete, :confirm => 'Are you sure?'


= link_to '[new slide]', new_admin_slide_path
